# ---------- Public URL: what the browser uses (OAuth redirects, presigned media URLs, WS origin, email links) ----------
# Demo: https://42clubroom.ensui.dev   |   local prod-like test without tunnel: http://localhost:8080
APP_PUBLIC_URL=https://42clubroom.ensui.dev
# Interface the proxy listens on: 127.0.0.1 if cloudflared runs on this host, this host's LAN IP otherwise (R-26)
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# true behind HTTPS (Cloudflare); false only for plain-http tests on a LAN IP
COOKIE_SECURE=true
BACKEND_REPLICAS=2
# Memory limit per backend instance (the JVM heap is 75% of it); about 600 MB are in use
BACKEND_MEMORY=1g

# ---------- 42 OAuth application (https://profile.intra.42.fr/oauth/applications) ----------
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# ---------- PostgreSQL ----------
DB_NAME=vclubroom
DB_USER=vclubroom
DB_PASSWORD=change-me-db

# ---------- Object storage ----------
# Dev: must match deploy/seaweedfs/s3.json. Demo: use a fresh secret (openssl rand -hex 24); deploy.sh renders
# deploy/seaweedfs/s3.prod.json from these two values, so the committed default never works there.
S3_ACCESS_KEY=vclubroom
S3_SECRET_KEY=change-me-s3-secret

# ---------- Email (D-35): Resend over SMTP. Swap provider = change these values only ----------
# Local demo with Mailpit instead: SMTP_HOST=mailpit SMTP_PORT=1025 SMTP_AUTH=false SMTP_STARTTLS=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
# Resend API key (re_...), sending access restricted to the 42clubroom.ensui.dev domain
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_TRANSPORT=smtp
MAIL_FROM="Virtual Clubroom <no-reply@42clubroom.ensui.dev>"
# Support emails (E17) come from their own address, so they stand apart from club news
MAIL_SUPPORT_FROM="Virtual Clubroom Support <support@42clubroom.ensui.dev>"

# ---------- Cloudflare Tunnel: only for the 'tunnel' compose profile (option B, §8.2) ----------
CLOUDFLARE_TUNNEL_TOKEN=
# Start that connector with the stack (deploy.sh, docker compose):
# COMPOSE_PROFILES=tunnel

# ---------- Ticket tracker (E17): Forgejo, for the team only ----------
# Where the team opens it (Cloudflare tunnel hostname). Local prod-like test: http://localhost:3000/
TICKETS_PUBLIC_URL=https://tickets.ensui.dev/
TICKETS_PORT=3000
# Written by scripts/tickets-setup.sh: the token of the bot the backend uses (E17-S02)
TICKETS_FORGEJO_TOKEN=

# ---------- Admin bootstrap (R-09) ----------
# comma-separated 42 logins that become ADMIN on first login
APP_ADMIN_BOOTSTRAP_LOGINS=
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin